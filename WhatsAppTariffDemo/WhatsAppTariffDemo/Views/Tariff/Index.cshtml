        .wa-chat-preview {
            font-size: 13.8px;
            color: var(--wa-sub);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-top: 2px;
        }

        .wa-badge {
            background: var(--wa-teal);
            color: #fff;
            border-radius: 50%;
            min-width: 20px;
            height: 20px;
            font-size: 12px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-left: 8px;
        }

        .wa-side-foot {
            margin-top: auto;
            padding: 14px 18px;
            font-size: 12px;
            color: var(--wa-sub);
            background: var(--wa-panel);
        }

        /* ---------- Chat panel ---------- */
        .wa-main {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        .wa-head {
            height: 59px;
            background: var(--wa-panel);
            display: flex;
            align-items: center;
            padding: 0 16px;
            gap: 15px;
            border-bottom: 1px solid var(--wa-line);
        }

            .wa-head .wa-avatar {
                width: 40px;
                height: 40px;
                font-size: 19px;
            }

        .wa-head-info {
            flex: 1;
            min-width: 0;
        }

        .wa-head-name {
            font-size: 16px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .wa-verified {
            color: var(--wa-teal);
            font-size: 14px;
        }

        .wa-head-status {
            font-size: 13px;
            color: var(--wa-sub);
            margin-top: 1px;
        }

        .wa-head-actions {
            display: flex;
            gap: 22px;
            color: var(--wa-sub);
            font-size: 17px;
            align-items: center;
        }

        .wa-attempts {
            font-size: 12px;
            background: #fff;
            border-radius: 12px;
            padding: 3px 10px;
            color: var(--wa-sub);
            border: 1px solid var(--wa-line);
        }

            .wa-attempts b {
                color: var(--wa-text);
            }

        .wa-body {
            flex: 1;
            overflow-y: auto;
            padding: 18px 7% 14px;
            background-color: var(--wa-chat-bg);
            background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='120' height='120' viewBox='0 0 120 120'><g fill='none' stroke='%23d5cdbf' stroke-width='1.4' opacity='.55'><circle cx='18' cy='20' r='5'/><path d='M62 14l8 8m0-8l-8 8'/><rect x='88' y='12' width='12' height='9' rx='2'/><path d='M14 70q6-8 12 0t12 0'/><circle cx='70' cy='64' r='3'/><path d='M96 62l7 7-7 7-7-7z'/><path d='M26 104h14M33 97v14'/><circle cx='86' cy='104' r='5'/></g></svg>");
        }

        .wa-chip {
            display: table;
            margin: 6px auto 10px;
            background: #fff;
            color: var(--wa-chip-text);
            font-size: 12.5px;
            padding: 5px 12px;
            border-radius: 7.5px;
            box-shadow: 0 1px .5px rgba(11, 20, 26, .13);
            text-transform: uppercase;
        }

            .wa-chip.note {
                background: var(--wa-chip);
                text-transform: none;
                text-align: center;
                max-width: 560px;
                line-height: 1.4;
                font-size: 12.3px;
            }

        .wa-row {
            display: flex;
            margin-bottom: 2px;
        }

            .wa-row.out {
                justify-content: flex-end;
            }

            .wa-row.first {
                margin-top: 10px;
            }

        .wa-msg {
            position: relative;
            max-width: 65%;
            padding: 6px 7px 8px 9px;
            border-radius: 7.5px;
            box-shadow: 0 1px .5px rgba(11, 20, 26, .13);
            font-size: 14.2px;
            line-height: 19px;
            word-wrap: break-word;
        }

            .wa-msg.in {
                background: var(--wa-in);
            }

            .wa-msg.out {
                background: var(--wa-out);
            }

            .wa-msg.in.tail {
                border-top-left-radius: 0;
            }

            .wa-msg.out.tail {
                border-top-right-radius: 0;
            }

            .wa-msg.in.tail::before {
                content: "";
                position: absolute;
                top: 0;
                left: -8px;
                border-top: 0 solid transparent;
                border-right: 8px solid var(--wa-in);
                border-bottom: 13px solid transparent;
            }

            .wa-msg.out.tail::before {
                content: "";
                position: absolute;
                top: 0;
                right: -8px;
                border-top: 0 solid transparent;
                border-left: 8px solid var(--wa-out);
                border-bottom: 13px solid transparent;
            }

        .wa-sender {
            font-size: 12.8px;
            font-weight: 600;
            color: var(--wa-teal-dark);
            margin-bottom: 2px;
        }

        .wa-text b {
            font-weight: 600;
        }

        .wa-meta {
            float: right;
            margin: 6px 0 -5px 12px;
            font-size: 11px;
            color: var(--wa-sub);
            display: inline-flex;
            align-items: center;
            gap: 3px;
            line-height: 15px;
        }

            .wa-meta .fa-check-double {
                color: var(--wa-tick);
                font-size: 11px;
            }

        .wa-msg.receipt {
            max-width: 440px;
            width: 100%;
        }

        /* Quick reply chips inside message for stations/cargo */
        .wa-options-box {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: 8px;
        }

        .wa-option-btn {
            background: #e1f5fe;
            border: 1px solid #b3e5fc;
            color: #01579b;
            border-radius: 15px;
            padding: 5px 14px;
            font-size: 13px;
            cursor: pointer;
            font-weight: 600;
            transition: background 0.2s;
        }

            .wa-option-btn:hover {
                background: #b3e5fc;
            }

        /* ---------- Composer ---------- */
        .wa-foot {
            background: var(--wa-panel);
            padding: 10px 16px;
        }

            .wa-foot form {
                display: flex;
                align-items: center;
                gap: 12px;
                margin: 0;
            }

            .wa-foot .ico {
                color: var(--wa-sub);
                font-size: 22px;
                width: 26px;
                text-align: center;
            }

        .wa-input, .wa-date-input {
            flex: 1;
            border: 0;
            outline: 0;
            background: #fff;
            border-radius: 8px;
            padding: 10px 14px;
            font: inherit;
            font-size: 15px;
            color: var(--wa-text);
        }

            .wa-input:disabled {
                background: #fff;
                color: var(--wa-sub);
            }

            .wa-input::placeholder {
                color: var(--wa-sub);
            }

        .wa-send {
            border: 0;
            background: none;
            color: var(--wa-sub);
            font-size: 21px;
            width: 40px;
            height: 40px;
            cursor: pointer;
            border-radius: 50%;
        }

            .wa-send:not(:disabled) {
                color: var(--wa-teal);
            }

            .wa-send:disabled {
                cursor: not-allowed;
                opacity: .6;
            }

            .wa-send:focus-visible, .wa-input:focus-visible, .wa-date-input:focus-visible {
                outline: 2px solid var(--wa-teal);
            }

        .wa-ended {
            background: var(--wa-panel);
            text-align: center;
            color: var(--wa-sub);
            font-size: 13.5px;
            padding: 6px 16px 14px;
        }

            .wa-ended a {
                color: #027eb5;
                text-decoration: none;
            }

        /* ---------- Date picker ---------- */
        .wa-datebox { flex: 1; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
        .wa-quick { display: flex; flex-wrap: wrap; gap: 6px; }
        .wa-quick-btn {
            background: #fff; border: 1px solid var(--wa-line); color: var(--wa-text);
            border-radius: 16px; padding: 7px 15px; font-size: 13.5px; font-weight: 600;
            cursor: pointer; transition: background .2s, border-color .2s, color .2s;
        }
        .wa-quick-btn:hover { background: #e1f5fe; border-color: #b3e5fc; color: #01579b; }
        .wa-quick-btn.primary { background: var(--wa-teal); border-color: var(--wa-teal); color: #fff; }
        .wa-quick-btn.primary:hover { background: var(--wa-teal-dark); border-color: var(--wa-teal-dark); color: #fff; }
        .wa-selects { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
        .wa-selects select {
            border: 1px solid var(--wa-line); background: #fff; border-radius: 8px;
            padding: 8px 10px; font: inherit; font-size: 14.5px; color: var(--wa-text); cursor: pointer;
        }
        .wa-selects select:focus-visible { outline: 2px solid var(--wa-teal); }
        .wa-datepreview { font-weight: 600; color: var(--wa-teal-dark); margin-left: 6px; }
        .wa-datepreview.err { color: #c62828; }

        @@media (max-width: 860px) {
            .wa-side {
                display: none;
            }

            .wa-app {
                height: 100vh;
                margin: 0;
            }

            .wa-backdrop {
                display: none;
            }

            .wa-body {
                padding: 14px 4%;
            }

            .wa-msg {
                max-width: 85%;
            }
        }
    </style>
</head>
<body>
    <div class="wa-backdrop"></div>

    <div class="wa-app">

        <!-- ============ Chat list ============ -->
        <aside class="wa-side">
            <div class="wa-side-head">
                <div class="me"><i class="fa-solid fa-user"></i></div>
                <div class="spacer"></div>
                <i class="fa-solid fa-circle-notch" title="Status"></i>
                <i class="fa-regular fa-message" title="New chat"></i>
                <i class="fa-solid fa-ellipsis-vertical" title="Menu"></i>
            </div>

            <div class="wa-search">
                <div><i class="fa-solid fa-magnifying-glass"></i> Search or start a new chat</div>
            </div>

            <div class="wa-chat-item active">
                <div class="wa-avatar av-bot"><i class="fa-brands fa-whatsapp"></i></div>
                <div class="wa-chat-meta">
                    <div class="wa-chat-row">
                        <span class="wa-chat-name">Gerry's dnata Tariff Bot <i class="fa-solid fa-circle-check wa-verified"></i></span>
                        <span class="wa-chat-time">@lastTime</span>
                    </div>
                    <div class="wa-chat-row">
                        <span class="wa-chat-preview">Import cargo storage estimate</span>
                    </div>
                </div>
            </div>
<div class="wa-chat-item @(Model.IsEscalated ? "active" : "")" 
     style="@(Model.IsEscalated ? "cursor: pointer; background: #f0f2f5;" : "cursor: not-allowed; opacity: 0.6;")" 
     @if(Model.IsEscalated) { <text>onclick="window.open('https://wa.me/923039200623?text=Hello%2C%20I%20need%20help%20with%20Cargo%20Ops%20Escalation', '_blank')"</text> }>
    <div class="wa-avatar av-agent"><i class="fa-solid fa-headset"></i></div>
    <div class="wa-chat-meta">
        <div class="wa-chat-row">
            <span class="wa-chat-name">Cargo Ops Desk</span>
            @if (Model.IsEscalated)
            {
                <span class="wa-chat-time unread">@lastTime</span>
            }
        </div>
        <div class="wa-chat-row">
            <span class="wa-chat-preview">
                @(Model.IsEscalated ? "New case handed over from Tariff Bot" : "Locked (Available on escalation)")
            </span>
            @if (Model.IsEscalated)
            {
                <span class="wa-badge">1</span>
            }
        </div>
    </div>
</div>

            <div class="wa-side-foot"><i class="fa-solid fa-lock"></i>&nbsp; Pan Pakistan hubs: KHI, LHE, ISB, MUX</div>
        </aside>

        <!-- ============ Conversation ============ -->
        <section class="wa-main">

            <header class="wa-head">
                <div class="wa-avatar av-bot"><i class="fa-brands fa-whatsapp"></i></div>
                <div class="wa-head-info">
                    <div class="wa-head-name">Gerry's dnata Tariff Bot <i class="fa-solid fa-circle-check wa-verified" title="Verified business account"></i></div>
                    <div class="wa-head-status" id="statusLine">
                        @(Model.IsEscalated ? "Handed over to Cargo Ops agent" : "Business account · online")
                    </div>
                </div>
                <div class="wa-head-actions">
                    <span class="wa-attempts" title="Invalid AWB attempts before agent handover">Attempts <b>@Model.AttemptCount/3</b></span>
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <i class="fa-solid fa-ellipsis-vertical"></i>
                </div>
            </header>

            <div class="wa-body" id="chatScrollArea">

                <div class="wa-chip">Today</div>

                <div class="wa-chip note">
                    <i class="fa-solid fa-lock"></i>
                    This chat is with a verified business account. Storage estimates are indicative; final charges are confirmed at the terminal.
                </div>

                <div class="wa-chip note">
                    Demo: enter an invalid AWB 3 times to see the handover to a Cargo Ops agent.
                </div>

                @foreach (var msg in Model.Messages)
                {
                    bool isBot = msg.Sender == "Bot";
                    bool tail = prevSender != msg.Sender;
                    bool isReceipt = isBot && msg.Text != null && msg.Text.Contains("Tariff Calculation");
                    string cls = (isBot ? "in" : "out") + (tail ? " tail" : "") + (isReceipt ? " receipt" : "");

                    <div class="wa-row @(isBot ? "in" : "out") @(tail ? "first" : "")">
                        <div class="wa-msg @cls">
                            @if (isBot && tail)
                            {
                                <div class="wa-sender">Gerry's dnata</div>
                            }
                            <span class="wa-text">@Html.Raw(Fmt(msg.Text, msg.IsHtml))</span>

                            <!-- Option Buttons inside bot message if provided -->
                            @if (isBot && msg.Options != null && msg.Options.Count > 0 && !ended)
                            {
                                <div class="wa-options-box">
                                    @foreach (var opt in msg.Options)
                                    {
                                        <button type="button" class="wa-option-btn" onclick="submitOption('@opt')">@opt</button>
                                    }
                                </div>
                            }

                            <span class="wa-meta">
                                @msg.Time
                                @if (!isBot)
                                {
                                    <i class="fa-solid fa-check-double"></i>
                                }
                            </span>
                        </div>
                    </div>

                    prevSender = msg.Sender;
                }

            </div>

            @if (ended)
            {
                <div class="wa-ended">
                    @(Model.IsEscalated ? "A Cargo Ops agent will continue this conversation." : "This conversation has ended.")
                    <a href="@Url.Action("Index")">Start a new chat</a>
                </div>
            }

            <footer class="wa-foot">
                <form asp-action="Index" method="post" id="chatForm">
                    <input type="hidden" name="stateJson" value="@JsonSerializer.Serialize(Model)" />
                    <input type="hidden" name="userInput" id="hiddenInput" />

                    <i class="fa-regular fa-face-smile ico"></i>
                    <i class="fa-solid fa-plus ico"></i>

                  @if (!ended && (Model.CurrentStep == 4 || Model.CurrentStep == 5))
{
    bool isPayment = Model.CurrentStep == 5;
    @* Step 4 = Arrival Date, Step 5 = Payment Date *@
    <input type="hidden" id="dateInput" />
    <div class="wa-datebox" id="dateBox" data-step="@Model.CurrentStep" data-min="@(Model.TempDispatchDate.ToString("yyyy-MM-dd"))">
        <div class="wa-quick">
            @if (isPayment)
            {
                <button type="button" class="wa-quick-btn primary" onclick="pickQuick(0)"><i class="fa-regular fa-calendar-check"></i> Today <span id="todayLabel"></span></button>
                <button type="button" class="wa-quick-btn" onclick="toggleCustom()"><i class="fa-regular fa-calendar"></i> Choose another date</button>
            }
            else
            {
                <button type="button" class="wa-quick-btn" onclick="pickQuick(0)">Today</button>
                <button type="button" class="wa-quick-btn" onclick="pickQuick(1)">Yesterday</button>
                <button type="button" class="wa-quick-btn" onclick="pickQuick(3)">3 days ago</button>
                <button type="button" class="wa-quick-btn" onclick="pickQuick(7)">1 week ago</button>
            }
        </div>
        <div class="wa-selects" id="customDate" style="@(isPayment ? "display:none" : "")">
            <select id="selDay" aria-label="Day"></select>
            <select id="selMonth" aria-label="Month"></select>
            <select id="selYear" aria-label="Year"></select>
            <span class="wa-datepreview" id="datePreview"></span>
        </div>
    </div>
}
else
{
    <input type="text" id="userInput" class="wa-input" required autocomplete="off"
           placeholder="@(ended ? "You can't reply to this conversation" : "Type a message or select an option...")"
           @(ended ? "disabled" : "") />
}
                        <button type="submit" class="wa-send" aria-label="Send" @(ended ? "disabled" : "") onclick="return prepareSubmit()">
                        <i class="fa-solid fa-paper-plane"></i>
                    </button>
                </form>
            </footer>

        </section>
    </div>

    <script>
        var chatArea = document.getElementById("chatScrollArea");
        chatArea.scrollTop = chatArea.scrollHeight;

        var form = document.getElementById("chatForm");
        var status = document.getElementById("statusLine");

        function showTyping() {
            if (status) {
                status.innerHTML = 'typing<span class="wa-typing-dots"><span>.</span><span>.</span><span>.</span></span>';
            }
        }

        function submitOption(val) {
            document.getElementById("hiddenInput").value = val;
            showTyping();
            form.submit();
        }

                  var MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
                var dateIsValid = true;

                function pad(n) { return (n < 10 ? "0" : "") + n; }
                function toIso(d) { return d.getFullYear() + "-" + pad(d.getMonth() + 1) + "-" + pad(d.getDate()); }
                function toNice(d) { return pad(d.getDate()) + " " + MONTHS[d.getMonth()] + " " + d.getFullYear(); }
                function startOfToday() { var t = new Date(); return new Date(t.getFullYear(), t.getMonth(), t.getDate()); }

                function initDatePicker() {
                    var selDay = document.getElementById("selDay");
                    var selMonth = document.getElementById("selMonth");
                    var selYear = document.getElementById("selYear");
                    var today = startOfToday();
                    var i;

                    for (i = 1; i <= 31; i++) { selDay.add(new Option(pad(i), i)); }
                    for (i = 0; i < 12; i++) { selMonth.add(new Option(MONTHS[i], i)); }
                    for (i = today.getFullYear(); i >= today.getFullYear() - 1; i--) { selYear.add(new Option(i, i)); }

                    selDay.value = today.getDate();
                    selMonth.value = today.getMonth();
                    selYear.value = today.getFullYear();

                    [selDay, selMonth, selYear].forEach(function (s) { s.addEventListener("change", updateDate); });

                    var tl = document.getElementById("todayLabel");
                    if (tl) { tl.textContent = "(" + toNice(today) + ")"; }
                    updateDate();
                }

                function updateDate() {
                    var box = document.getElementById("dateBox");
                    var selDay = document.getElementById("selDay");
                    var selMonth = document.getElementById("selMonth");
                    var selYear = document.getElementById("selYear");
                    var preview = document.getElementById("datePreview");

                    var y = parseInt(selYear.value, 10), m = parseInt(selMonth.value, 10), d = parseInt(selDay.value, 10);
                    var lastDay = new Date(y, m + 1, 0).getDate();
                    if (d > lastDay) { d = lastDay; selDay.value = d; }
                    var date = new Date(y, m, d);

                    var msg = "";
                    var step = box.getAttribute("data-step");
                    if (step === "4" && date > startOfToday()) {
                        msg = "Arrival date cannot be in the future";
                    }
                    if (step === "5") {
                        var min = box.getAttribute("data-min");
                        if (min && toIso(date) < min) { msg = "Payment date must be on or after the arrival date"; }
                    }

                    dateIsValid = (msg === "");
                    preview.textContent = msg !== "" ? msg : toNice(date);
                    preview.className = "wa-datepreview" + (msg !== "" ? " err" : "");
                    document.getElementById("dateInput").value = toIso(date);
                }

                function pickQuick(daysAgo) {
                    var d = startOfToday();
                    d.setDate(d.getDate() - daysAgo);
                    document.getElementById("hiddenInput").value = toIso(d);
                    showTyping();
                    form.submit();
                }

                function toggleCustom() {
                    var c = document.getElementById("customDate");
                    c.style.display = (c.style.display === "none") ? "flex" : "none";
                }

                function prepareSubmit() {
                    var dateInput = document.getElementById("dateInput");
                    var userInput = document.getElementById("userInput");
                    var hiddenInput = document.getElementById("hiddenInput");

                    if (dateInput) {
                        updateDate();
                        if (!dateIsValid) { return false; }
                        hiddenInput.value = dateInput.value;
                    } else if (userInput) {
                        hiddenInput.value = userInput.value;
                    }
                    return true;
                }

                if (document.getElementById("dateBox")) { initDatePicker(); }

        form.addEventListener("submit", showTyping);
    </script>
</body>
</html>