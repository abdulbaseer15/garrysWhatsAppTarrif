@model WhatsAppTariffDemo.Models.ChatSessionState
@using System.Text.Json
@using System.Text.RegularExpressions
@using System.Net

@functions {
    // Turns bot text into WhatsApp-style formatting: *bold* / **bold**, line breaks, and removes stray markers
    static string Fmt(string text, bool isHtml)
    {
        if (string.IsNullOrEmpty(text)) return "";
        text = Regex.Replace(text, @"\s*\[cite:\s*[\d,\s]+\]", "");
        var s = isHtml ? text : WebUtility.HtmlEncode(text);
        s = Regex.Replace(s, @"\*\*(.+?)\*\*", "<b>$1</b>");
        s = Regex.Replace(s, @"(?<![\w*])\*(?!\s)(.+?)(?<!\s)\*(?![\w*])", "<b>$1</b>");
        s = s.Replace("\r\n", "\n").Trim().Replace("\n", "<br/>");
        return s;
    }
}

@{
    ViewData["Title"] = "Gerry's dnata Tariff Bot";
    Layout = null;
    bool ended = Model.IsEscalated || Model.IsCompleted;
    string prevSender = null;
    string lastTime = Model.Messages.Count > 0 ? Model.Messages[Model.Messages.Count - 1].Time : "";
    var lastMsg = Model.Messages.LastOrDefault();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gerry's dnata - WhatsApp Tariff Bot</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --wa-teal: #00a884;
            --wa-teal-dark: #008069;
            --wa-panel: #f0f2f5;
            --wa-chat-bg: #efeae2;
            --wa-in: #ffffff;
            --wa-out: #d9fdd3;
            --wa-text: #111b21;
            --wa-sub: #667781;
            --wa-line: #e9edef;
            --wa-tick: #53bdeb;
            --wa-chip: #ffeecd;
