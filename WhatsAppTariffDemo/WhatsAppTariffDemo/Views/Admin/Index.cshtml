@model IEnumerable<WhatsAppTariffDemo.Models.TariffRuleModel>

@{
    Layout = null;
    string lastTime = DateTime.Now.ToString("yyyy-MM-dd HH:mm");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tariff Rules Admin Panel - Gerry's dnata</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
            :root {
                --wa-teal: #00a884;
                --wa-teal-dark: #008069;
                --wa-panel-bg: #f0f2f5;
            }

            body {
                background-color: #d1d7db;
                font-family: "Segoe UI", "Helvetica Neue", Helvetica, Arial, sans-serif;
                color: #111b21;
            }

            .admin-container {
                max-width: 1300px;
                margin: 40px auto;
                padding: 0 15px;
            }

            .admin-card {
                background: #ffffff;
                border-radius: 12px;
                box-shadow: 0 6px 20px rgba(11, 20, 26, 0.15);
                border-top: 5px solid var(--wa-teal);
                padding: 30px;
            }

            .btn-wa-success {
                background-color: var(--wa-teal);
                border-color: var(--wa-teal);
                color: #fff;
                font-weight: 600;
            }

                .btn-wa-success:hover {
                    background-color: var(--wa-teal-dark);
                    border-color: var(--wa-teal-dark);
                    color: #fff;
                }

            .table-custom th {
                background-color: #111b21 !important;
                color: #ffffff !important;
                font-weight: 600;
                border: none;
                padding: 12px 15px;
            }

            .table-custom td {
                vertical-align: middle;
                padding: 12px 15px;
            }

         
                .badge-general {
                    background-color: #00a884; /* WhatsApp Green */
                    color: #ffffff;
                    padding: 6px 14px;
                    font-weight: 600;
                    border-radius: 20px;
                    font-size: 0.85rem;
                }

                .badge-special {
                    background-color: #ff9800; /* Professional Amber / Orange */
                    color: #ffffff;
                    padding: 6px 14px;
                    font-weight: 600;
                    border-radius: 20px;
                    font-size: 0.85rem;
                }
      
    </style>
</head>
<body>
    <div class="admin-container">
        <div class="admin-card">
            <!-- Header Section -->
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom flex-wrap gap-3">
                <div class="d-flex align-items-center">
                    <div class="fs-2 text-success me-3">
                        <i class="fa-brands fa-whatsapp"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-1 text-dark">Gerry's dnata - Tariff Rules Admin Panel</h3>
                        <p class="text-muted mb-0 small">Manage import cargo storage rates, free days, and weight slabs.</p>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Create" class="btn btn-wa-success">
                        <i class="fa-solid fa-plus me-1"></i> Add New Rule
                    </a>
                    <a asp-controller="Tariff" asp-action="Index" class="btn btn-outline-dark" target="_blank">
                        <i class="fa-brands fa-whatsapp me-1"></i> Open Chat Bot
                    </a>
                </div>
            </div>

            <!-- Table Section -->
            <div class="table-responsive">
                <table class="table table-hover table-custom align-middle">
                    <thead>
                        <tr>
                            <th>Station</th>
                            <th>Cargo Type</th>
                            <th>Free Days</th>
                            <th>Rate / Kg (PKR)</th>
                            <th>Min Charge (PKR)</th>
                            <th>Tax (%)</th>
                            <th>Weight Slabs</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@item.StationCode</td>
                                    <td>
                                        @if (item.CargoType == "Special")
                                        {
                                            <span class="badge-special">
                                                <i class="fa-solid fa-star me-1"></i> Special
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge-general">
                                                <i class="fa-solid fa-box me-1"></i> General
                                            </span>
                                        }
                                    </td>
                                    <td>@item.FreeDays Days</td>
                                    <td>Rs. @item.RatePerKg.ToString("N2")</td>
                                    <td>Rs. @item.MinimumCharge.ToString("N2")</td>
                                    <td>@item.TaxPercentage.ToString("0.00")%</td>
                                    <td><small class="text-muted">@item.MinWeightSlab kg - @item.MaxWeightSlab kg</small></td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <a asp-action="Edit" asp-route-id="@item.RuleId" class="btn btn-primary btn-sm px-3" title="Edit Rule">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.RuleId" class="btn btn-danger btn-sm px-3" title="Delete Rule" onclick="return confirm('Kya aap is rule ko delete karna chahte hain?');">
                                                <i class="fa-solid fa-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">No tariff rules found. Please add a new rule.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>